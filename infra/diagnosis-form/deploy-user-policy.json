{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FormLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction", "lambda:UpdateFunctionCode", "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction", "lambda:GetFunctionConfiguration",
        "lambda:CreateFunctionUrlConfig", "lambda:UpdateFunctionUrlConfig", "lambda:GetFunctionUrlConfig",
        "lambda:AddPermission", "lambda:RemovePermission", "lambda:GetPolicy",
        "lambda:PutFunctionConcurrency", "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-2:242126391246:function:dotmate-diagnosis-form"
    },
    {
      "Sid": "PassFormRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::242126391246:role/dotmate-diagnosis-form-role",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
    },
    {
      "Sid": "SesIdentity",
      "Effect": "Allow",
      "Action": ["ses:CreateEmailIdentity", "ses:GetEmailIdentity", "ses:PutEmailIdentityMailFromAttributes"],
      "Resource": "arn:aws:ses:ap-northeast-2:242126391246:identity/dotmate.co.kr"
    },
    {
      "Sid": "SesRead",
      "Effect": "Allow",
      "Action": ["ses:ListEmailIdentities", "ses:GetAccount"],
      "Resource": "*"
    },
    {
      "Sid": "FormLogs",
      "Effect": "Allow",
      "Action": ["logs:FilterLogEvents", "logs:GetLogEvents", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:ap-northeast-2:242126391246:log-group:/aws/lambda/dotmate-diagnosis-form:*"
    }
  ]
}
